# Auto-normalize all text files to LF
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.svg binary
*.zip binary
*.tar.gz binary
*.pyc binary

# Source and data files
*.py text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ipynb text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
